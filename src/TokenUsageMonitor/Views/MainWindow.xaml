<Window x:Class="TokenUsageMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TokenUsageMonitor.Views"
        xmlns:vm="clr-namespace:TokenUsageMonitor.ViewModels"
        xmlns:conv="clr-namespace:TokenUsageMonitor.Converters"
        xmlns:models="clr-namespace:TokenUsageMonitor.Models"
        mc:Ignorable="d"
        Title="Token 用量监控"
        Height="420" Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <conv:StringEqualityConverter x:Key="StringEqualityConverter"/>
        <conv:HealthDataToPointsConverter x:Key="HealthDataToPointsConverter"/>
        <conv:PercentageConverter x:Key="PercentageConverter" MaxWidth="260"/>
        <conv:PercentageConverter x:Key="SmallPercentageConverter" MaxWidth="110"/>

        <!-- Zhipu DataTemplate -->
        <DataTemplate x:Key="ZhipuTemplate" DataType="{x:Type models:PlatformInfo}">
            <StackPanel>
                <!-- Main Usage Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="MCP 用量" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataContext.UsageCards[0].DetailText, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GlmBrandBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ProBadgeStyle}" Visibility="{Binding IsPro, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Height="6" Background="{StaticResource ProgressBarBackgroundBrush}" Margin="0,8,0,0" CornerRadius="3">
                            <Rectangle Fill="{StaticResource GlmBrandBrush}" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                                conv:AnimatedWidthConverter.SmoothWidth="{Binding DataContext.UsageCards[0].Percentage, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource PercentageConverter}}"/>
                        </Border>
                        
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding DataContext.UsageCards[0].TimeRangeText, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </Grid>
                </Border>
                
                <!-- Small Cards Row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Style="{StaticResource SmallCardBorderStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="5小时额度" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DataContext.UsageCards[1].Percentage, RelativeSource={RelativeSource AncestorType=ContentPresenter}, StringFormat={}{0}%}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="4" Background="{StaticResource ProgressBarBackgroundBrush}" Margin="0,6,0,0" CornerRadius="2">
                                <Rectangle Fill="{StaticResource ProgressBarFillBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                                    conv:AnimatedWidthConverter.SmoothWidth="{Binding DataContext.UsageCards[1].Percentage, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource SmallPercentageConverter}}"/>
                            </Border>
                            <TextBlock Text="{Binding DataContext.UsageCards[1].TimeRangeText, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="2" Style="{StaticResource SmallCardBorderStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="周额度" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DataContext.UsageCards[2].Percentage, RelativeSource={RelativeSource AncestorType=ContentPresenter}, StringFormat={}{0}%}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="4" Background="{StaticResource ProgressBarBackgroundBrush}" Margin="0,6,0,0" CornerRadius="2">
                                <Rectangle Fill="{StaticResource ProgressBarFillBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                                    conv:AnimatedWidthConverter.SmoothWidth="{Binding DataContext.UsageCards[2].Percentage, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource SmallPercentageConverter}}"/>
                            </Border>
                            <TextBlock Text="{Binding DataContext.UsageCards[2].TimeRangeText, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Toggle & Time Range -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ToggleButton Content="Token" Style="{StaticResource ToggleTagButtonStyle}" IsChecked="{Binding DataContext.IsTokenMode, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Command="{Binding DataContext.ToggleTokenModeCommand, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" CommandParameter="Token"/>
                        <ToggleButton Content="MCP" Style="{StaticResource ToggleTagButtonStyle}" Margin="4,0,0,0" IsChecked="{Binding DataContext.IsTokenMode, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource InverseBooleanConverter}}" Command="{Binding DataContext.ToggleTokenModeCommand, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" CommandParameter="MCP"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ToggleButton Content="本日" Style="{StaticResource TimeRangeButtonStyle}" Margin="2,0,0,0" IsChecked="{Binding DataContext.SelectedTimeRange, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource StringEqualityConverter}, ConverterParameter='本日'}" Command="{Binding DataContext.SwitchTimeRangeCommand, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" CommandParameter="本日"/>
                        <ToggleButton Content="24h" Style="{StaticResource TimeRangeButtonStyle}" Margin="2,0,0,0" IsChecked="{Binding DataContext.SelectedTimeRange, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource StringEqualityConverter}, ConverterParameter='24h'}" Command="{Binding DataContext.SwitchTimeRangeCommand, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" CommandParameter="24h"/>
                        <ToggleButton Content="7天" Style="{StaticResource TimeRangeButtonStyle}" Margin="2,0,0,0" IsChecked="{Binding DataContext.SelectedTimeRange, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource StringEqualityConverter}, ConverterParameter='7天'}" Command="{Binding DataContext.SwitchTimeRangeCommand, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" CommandParameter="7天"/>
                        <ToggleButton Content="30天" Style="{StaticResource TimeRangeButtonStyle}" Margin="2,0,0,0" IsChecked="{Binding DataContext.SelectedTimeRange, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource StringEqualityConverter}, ConverterParameter='30天'}" Command="{Binding DataContext.SwitchTimeRangeCommand, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" CommandParameter="30天"/>
                    </StackPanel>
                </Grid>
                
                <!-- Stats Header -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{Binding DataContext.TotalUsageText, RelativeSource={RelativeSource AncestorType=ContentPresenter}, StringFormat='使用统计 {0}'}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DataContext.TotalCostText, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                
                <!-- Bar Chart Placeholder -->
                <Border Height="80" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Margin="0,0,0,8" Padding="8">
                    <ItemsControl ItemsSource="{Binding DataContext.ChartData, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="10" Margin="1,0">
                                    <Rectangle Fill="{StaticResource ChartSeries1Brush}" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" Height="{Binding Values[0]}"/>
                                    <Rectangle Fill="{StaticResource ChartSeries2Brush}" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" Height="{Binding Values[1]}"/>
                                    <Rectangle Fill="{StaticResource ChartSeries3Brush}" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" Height="{Binding Values[2]}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                
                <!-- Health Chart Placeholder -->
                <TextBlock Text="系统健康度" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                <Border Height="60" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Margin="0,0,0,8" Padding="8">
                    <Canvas>
                        <Polyline Points="{Binding DataContext.HealthData, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource HealthDataToPointsConverter}}" Stroke="{StaticResource ChartSeries2Brush}" StrokeThickness="2"/>
                    </Canvas>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- KIMI DataTemplate -->
        <DataTemplate x:Key="KimiTemplate" DataType="{x:Type models:PlatformInfo}">
            <ScrollViewer Style="{StaticResource CustomScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DataContext.KimiItems, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Percentage, StringFormat={}{0}%}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SubTitle}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                    <Border Height="4" Background="{StaticResource ProgressBarBackgroundBrush}" Margin="0,6,0,0" CornerRadius="2">
                                        <Rectangle Fill="{StaticResource KimiBrandBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                                            conv:AnimatedWidthConverter.SmoothWidth="{Binding Percentage, Converter={StaticResource PercentageConverter}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayText}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>

        <!-- DeepSeek DataTemplate -->
        <DataTemplate x:Key="DeepSeekTemplate" DataType="{x:Type models:PlatformInfo}">
            <StackPanel>
                <!-- Balance Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="总余额" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DataContext.UsageCards[0].UsedText, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding DataContext.UsageCards[0].DetailText, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        <Border Height="6" Background="{StaticResource ProgressBarBackgroundBrush}" Margin="0,8,0,0" CornerRadius="3">
                            <Rectangle Fill="{StaticResource DeepSeekBrandBrush}" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                                conv:AnimatedWidthConverter.SmoothWidth="{Binding DataContext.UsageCards[0].Percentage, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource PercentageConverter}}"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Service Status List -->
                <ItemsControl ItemsSource="{Binding DataContext.DeepSeekServices, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{StaticResource SuccessBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Percentage, StringFormat={}{0}%}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="6" Background="{StaticResource ProgressBarBackgroundBrush}" Margin="0,6,0,0" CornerRadius="3">
                                        <Rectangle Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                                            conv:AnimatedWidthConverter.SmoothWidth="{Binding Percentage, Converter={StaticResource PercentageConverter}}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="{StaticResource MainBackgroundBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Grid Grid.Row="0" Height="32" Margin="0,0,0,8">
                <TextBlock Text="Token 用量监控" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Command="{Binding RefreshCommand}" ToolTip="刷新"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,0" ToolTip="设置" Command="{Binding OpenSettingsCommand}"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,0" ToolTip="夜间模式" Command="{Binding ToggleDarkModeCommand}"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,0" ToolTip="关闭" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
            
            <!-- Platform Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <ToggleButton Content="GLM" Style="{StaticResource PlatformTabButtonStyle}" IsChecked="{Binding SelectedPlatform.Name, Converter={StaticResource StringEqualityConverter}, ConverterParameter='GLM'}" Command="{Binding SwitchPlatformCommand}" CommandParameter="{Binding Platforms[0]}"/>
                <ToggleButton Content="KIMI" Style="{StaticResource PlatformTabButtonStyle}" Margin="4,0,0,0" IsChecked="{Binding SelectedPlatform.Name, Converter={StaticResource StringEqualityConverter}, ConverterParameter='KIMI'}" Command="{Binding SwitchPlatformCommand}" CommandParameter="{Binding Platforms[1]}"/>
                <ToggleButton Content="DeepSeek" Style="{StaticResource PlatformTabButtonStyle}" Margin="4,0,0,0" IsChecked="{Binding SelectedPlatform.Name, Converter={StaticResource StringEqualityConverter}, ConverterParameter='DeepSeek'}" Command="{Binding SwitchPlatformCommand}" CommandParameter="{Binding Platforms[2]}"/>
            </StackPanel>
            
            <!-- Content Area -->
            <ScrollViewer Grid.Row="2" Style="{StaticResource CustomScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding SelectedPlatform}">
                    <ContentControl.ContentTemplateSelector>
                        <local:PlatformTemplateSelector 
                            ZhipuTemplate="{StaticResource ZhipuTemplate}"
                            KimiTemplate="{StaticResource KimiTemplate}"
                            DeepSeekTemplate="{StaticResource DeepSeekTemplate}"/>
                    </ContentControl.ContentTemplateSelector>
                </ContentControl>
            </ScrollViewer>
            
            <!-- Footer -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ConcurrentTestCommand}" ToolTip="并发测试" HorizontalAlignment="Center">
                    <Grid>
                        <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}}"/>
                        <Control Style="{StaticResource LoadingSpinnerStyle}" Width="14" Height="14"
                                 Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Button>
                <TextBlock Text="{Binding LastUpdateTime}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
