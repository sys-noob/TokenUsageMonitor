<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Morandi Palette Brushes -->
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#E8E3DF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F5F0EB"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9B9B9B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D0C8C0"/>

    <!-- Platform Brand Colors -->
    <SolidColorBrush x:Key="GlmBrandBrush" Color="#C8B8A8"/>
    <SolidColorBrush x:Key="KimiBrandBrush" Color="#A8B8C8"/>
    <SolidColorBrush x:Key="DeepSeekBrandBrush" Color="#B8A8B8"/>

    <!-- Progress Bar Colors -->
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#D5CEC7"/>
    <SolidColorBrush x:Key="ProgressBarFillBrush" Color="#B5A89A"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#A8B5A0"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#C8B898"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C8A8A0"/>

</ResourceDictionary>
