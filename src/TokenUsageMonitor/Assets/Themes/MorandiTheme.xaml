<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Morandi Palette Brushes -->
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#E8E3DF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F5F0EB"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9B9B9B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D0C8C0"/>

    <!-- Platform Brand Colors -->
    <SolidColorBrush x:Key="GlmBrandBrush" Color="#C8B8A8"/>
    <SolidColorBrush x:Key="MiniMaxBrandBrush" Color="#A8B8C8"/>
    <SolidColorBrush x:Key="DeepSeekBrandBrush" Color="#B8A8B8"/>

    <!-- Progress Bar Colors -->
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#D5CEC7"/>
    <SolidColorBrush x:Key="ProgressBarFillBrush" Color="#B5A89A"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#A8B5A0"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#C8B898"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C8A8A0"/>

    <!-- Chart Series Colors -->
    <SolidColorBrush x:Key="ChartSeries1Brush" Color="#A8B5A0"/>
    <SolidColorBrush x:Key="ChartSeries2Brush" Color="#A8B8C8"/>
    <SolidColorBrush x:Key="ChartSeries3Brush" Color="#C8B8A8"/>
    <SolidColorBrush x:Key="ChartSeries4Brush" Color="#C8B898"/>
    <SolidColorBrush x:Key="ChartSeries5Brush" Color="#B8A8B8"/>

    <!-- Card Style -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Small Card Style -->
    <Style x:Key="SmallCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Icon Button Style -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ProgressBarBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Platform Tab Button Style -->
    <Style x:Key="PlatformTabButtonStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Toggle Tag Button Style (Token/MCP, TimeRange) -->
    <Style x:Key="ToggleTagButtonStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ProgressBarBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Time Range Button Style (capsule) -->
    <Style x:Key="TimeRangeButtonStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="11"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- PRO Badge Style -->
    <Style x:Key="ProBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Progress Bar Style -->
    <Style x:Key="CustomProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{StaticResource ProgressBarBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ProgressBarFillBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Height="{TemplateBinding Height}"/>
                        <Border Background="{TemplateBinding Foreground}"
                                CornerRadius="3"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Left"
                                Width="{TemplateBinding Width, Converter={StaticResource ProgressBarValueConverter}}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small Progress Bar Style -->
    <Style x:Key="SmallProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource CustomProgressBarStyle}">
        <Setter Property="Height" Value="4"/>
    </Style>

    <!-- ScrollViewer Style -->
    <Style x:Key="CustomScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Style="{StaticResource MorandiScrollBarStyle}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MorandiScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="{StaticResource BorderBrush}" CornerRadius="2"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolTip Style -->
    <Style x:Key="MorandiToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="#CC4A4A4A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
