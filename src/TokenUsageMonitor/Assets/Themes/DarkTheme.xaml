<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark mode overrides for Windows native colors -->
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="ProgressBarFillBrush" Color="#0078D4"/>

    <!-- ToolTip dark override -->
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#2D2D2D"/>

</ResourceDictionary>
