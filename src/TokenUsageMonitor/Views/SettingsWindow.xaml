<Window x:Class="TokenUsageMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TokenUsageMonitor.ViewModels"
        mc:Ignorable="d"
        Title="设置"
        Height="480" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{StaticResource MainBackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <Window.Resources>
        <Style x:Key="SettingsSectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SettingsSubLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SettingsPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{StaticResource MainBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{StaticResource MainBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SmallActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Background" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="设置"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   Margin="0,0,0,12"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource CustomScrollViewerStyle}">
            <StackPanel>
                <!-- API Keys Section -->
                <Border Style="{StaticResource SettingsSectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="API Key" Style="{StaticResource SettingsLabelStyle}"/>

                        <TextBlock Text="GLM" Style="{StaticResource SettingsSubLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="GlmPasswordBox"
                                         Grid.Column="0"
                                         Style="{StaticResource SettingsPasswordBoxStyle}"
                                         PasswordChanged="GlmPasswordBox_PasswordChanged"/>
                            <Button Grid.Column="1"
                                    Content="保存"
                                    Style="{StaticResource SmallActionButtonStyle}"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveApiKeyCommand}"
                                    CommandParameter="GLM"/>
                        </Grid>

                        <TextBlock Text="KIMI" Style="{StaticResource SettingsSubLabelStyle}" Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="KimiPasswordBox"
                                         Grid.Column="0"
                                         Style="{StaticResource SettingsPasswordBoxStyle}"
                                         PasswordChanged="KimiPasswordBox_PasswordChanged"/>
                            <Button Grid.Column="1"
                                    Content="保存"
                                    Style="{StaticResource SmallActionButtonStyle}"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveApiKeyCommand}"
                                    CommandParameter="KIMI"/>
                        </Grid>

                        <TextBlock Text="DeepSeek" Style="{StaticResource SettingsSubLabelStyle}" Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="DeepSeekPasswordBox"
                                         Grid.Column="0"
                                         Style="{StaticResource SettingsPasswordBoxStyle}"
                                         PasswordChanged="DeepSeekPasswordBox_PasswordChanged"/>
                            <Button Grid.Column="1"
                                    Content="保存"
                                    Style="{StaticResource SmallActionButtonStyle}"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveApiKeyCommand}"
                                    CommandParameter="DeepSeek"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Refresh Interval -->
                <Border Style="{StaticResource SettingsSectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="刷新间隔" Style="{StaticResource SettingsLabelStyle}"/>
                        <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                                  SelectedValue="{Binding RefreshIntervalMinutes}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="1分钟" Tag="1"/>
                            <ComboBoxItem Content="5分钟" Tag="5"/>
                            <ComboBoxItem Content="15分钟" Tag="15"/>
                            <ComboBoxItem Content="30分钟" Tag="30"/>
                            <ComboBoxItem Content="手动刷新" Tag="0"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- General Options -->
                <Border Style="{StaticResource SettingsSectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="常规选项" Style="{StaticResource SettingsLabelStyle}"/>

                        <CheckBox Style="{StaticResource SettingsCheckBoxStyle}"
                                  Content="开机自启"
                                  IsChecked="{Binding StartWithWindows}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Style="{StaticResource SettingsCheckBoxStyle}"
                                  Content="失焦自动隐藏"
                                  IsChecked="{Binding AutoHideOnLostFocus}"/>
                    </StackPanel>
                </Border>

                <!-- Theme -->
                <Border Style="{StaticResource SettingsSectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="主题" Style="{StaticResource SettingsLabelStyle}"/>
                        <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                                  SelectedValue="{Binding SelectedTheme}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="跟随系统" Tag="System"/>
                            <ComboBoxItem Content="浅色" Tag="Light"/>
                            <ComboBoxItem Content="深色" Tag="Dark"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="取消"
                    Style="{StaticResource CancelButtonStyle}"
                    Command="{Binding CancelCommand}"/>
            <Button Content="保存"
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="8,0,0,0"
                    Command="{Binding SaveSettingsCommand}"/>
        </StackPanel>
    </Grid>
</Window>
