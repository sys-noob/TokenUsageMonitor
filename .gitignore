# Build outputs (auto-generated by MSBuild)
src/**/bin/
src/**/obj/
src/**/publish/

# Visual Studio
.vs/
*.user
*.suo
*.cache

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
src/**/packages/

# Test results
TestResults/

# OS files
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Debug directory - auto-generated build outputs
debug/

# Release directory - keep for manual release placement
# Do not ignore the directory itself, but ignore built executables
release/*.exe
release/*.dll
release/*.pdb
